{
  "name": "lea-tuteur-ia",
  "version": "0.0.0",
  "description": "Léa — tuteur IA incarné. Phase 0 : contrats uniquement (le LLM parle, le moteur déterministe sait/vérifie/tient le cadre).",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "demo": "node --import tsx src/demo.ts",
    "demo:avance": "node --import tsx src/demo-avance.ts",
    "serve": "node --import tsx src/serve.ts",
    "db:verify": "node --import tsx db/verify-local.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "pg": "^8.13.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
